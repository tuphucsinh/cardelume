APP_ENV=staging
APP_MODE=live
NODE_ENV=production
DATABASE_SCOPE=staging
R2_SCOPE=staging
R2_OBJECT_PREFIX=staging/cardelume
ANALYTICS_SCOPE=staging
ANALYTICS_NAMESPACE=cardelume-staging
RECOVERY_SECRET_SCOPE=staging
AI_BUDGET_SCOPE=staging
CLOUDFLARE_HOST_SCOPE=staging
# Non-payment beta: checkout is fail-closed and no Dodo credential is needed.
PAYMENT_MODE=off
EXPERIMENT_KILL_SWITCH=false
AI_EXPERIMENT_MAX_CALLS_PER_RUN=1500
AI_EXPERIMENT_MAX_GENERATIONS_PER_RUN=450
AI_EXPERIMENT_DAILY_COST_USD=100
# Configure separate/scoped staging credentials and hostname outside git.
