APP_ENV=production
APP_MODE=live
NODE_ENV=production
DATABASE_SCOPE=production
R2_SCOPE=production
ANALYTICS_SCOPE=production
ANALYTICS_NAMESPACE=cardelume-production
RECOVERY_SECRET_SCOPE=production
AI_BUDGET_SCOPE=production
