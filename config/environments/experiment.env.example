APP_ENV=experiment
APP_MODE=live
NODE_ENV=production
EXPERIMENT_ID=replace-with-registry-id
DATABASE_SCOPE=experiment
R2_SCOPE=experiment
R2_OBJECT_PREFIX=experiment/replace-with-registry-id
ANALYTICS_SCOPE=experiment
ANALYTICS_NAMESPACE=cardelume-experiment-replace-with-id
RECOVERY_SECRET_SCOPE=experiment
AI_BUDGET_SCOPE=experiment
CLOUDFLARE_HOST_SCOPE=experiment
DODO_PAYMENTS_ENVIRONMENT=test_mode
EXPERIMENT_KILL_SWITCH=false
AI_EXPERIMENT_MAX_CALLS_PER_RUN=300
AI_EXPERIMENT_MAX_GENERATIONS_PER_RUN=150
AI_EXPERIMENT_DAILY_COST_USD=20
