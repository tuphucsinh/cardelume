# ---------- Runtime ----------
# Explicit lane identity; do not infer from hostname/URL.
APP_ENV=production
NODE_ENV=production
APP_MODE=live
DATABASE_SCOPE=production
R2_SCOPE=production
R2_OBJECT_PREFIX=
ANALYTICS_SCOPE=production
ANALYTICS_NAMESPACE=cardelume-production
RECOVERY_SECRET_SCOPE=production
AI_BUDGET_SCOPE=production
CLOUDFLARE_HOST_SCOPE=production
# Unique per host, e.g. pi5-primary or oracle-fallback.
NODE_ID=
NEXT_PUBLIC_SITE_URL=https://cardelume.com

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# IMPORTANT: use a session-capable/direct connection for pg-boss.
DATABASE_URL=
# Optional dedicated session-capable connection for pg-boss sender/worker.
QUEUE_DATABASE_URL=

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=cardelume-public
R2_BUCKET_PRIVATE=cardelume-private
R2_PUBLIC_BASE_URL=


# ---------- Pricing ----------
# Base identity price: US$2.99.
# Language and market are separate concerns: locale controls copy; market controls price.
# Native Dodo currencies currently treated as USD / GBP / EUR / INR.
PRICING_EXTENDED_LOCAL_ENABLED=false
# Markets that have been manually verified end-to-end in Dodo checkout.
PRICING_VERIFIED_MARKETS=US,GB,FR,DE,ES,IT,IN
# When extended local pricing is enabled, CardeLume should absorb adaptive-currency
# conversion fees so checkout total matches the psychological price displayed.
DODO_ADAPTIVE_CURRENCY_FEES_INCLUSIVE=true

# Pricing experiments are prepared but OFF at launch.
PRICING_EXPERIMENT_ENABLED=false
PRICING_EXPERIMENT_VARIANT=control_299
# Required in production to bind the displayed server price to checkout.
PRICING_QUOTE_SECRET=

# ---------- Dormant Holiday Bundle ----------
# Five FINISHED cards in one checkout. Not credits, not wallet balance.
HOLIDAY_BUNDLE_ENABLED=false

# ---------- Dodo Payments ----------
# Step 6 uses Dodo hosted checkout sessions. For exact CardeLume psychological
# prices, configure one-time Pay-What-You-Want products with Tax Inclusive
# Pricing enabled, then bind each enabled quote currency to its matching product.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_WEBHOOK_TOLERANCE_SECONDS=300
# Explicit acknowledgement that the dashboard products above are PWYW/dynamic
# amount ready. Production checkout refuses to start unless this is true.
DODO_DYNAMIC_PRICING_READY=false
DODO_PRODUCT_ID_SINGLE_USD=
DODO_PRODUCT_ID_SINGLE_GBP=
DODO_PRODUCT_ID_SINGLE_EUR=
DODO_PRODUCT_ID_SINGLE_INR=
# Add DODO_PRODUCT_ID_SINGLE_<ISO4217> for any extended local currency enabled.
# Legacy single-product variables remain read-compatible only when its currency
# exactly matches the signed quote; prefer the per-currency variables above.
DODO_PRODUCT_ID_SINGLE=
DODO_PRODUCT_CURRENCY=USD
DODO_PRODUCT_ID_HOLIDAY_BUNDLE=

# ---------- Experiment / staging guardrails ----------
# For APP_ENV=experiment/staging use config/environments/*.env.example and separate credentials.
EXPERIMENT_ID=
EXPERIMENT_KILL_SWITCH=false
AI_EXPERIMENT_MAX_CALLS_PER_RUN=300
AI_EXPERIMENT_MAX_GENERATIONS_PER_RUN=150
AI_EXPERIMENT_DAILY_COST_USD=20

# ---------- AI ----------
AI_PROVIDER=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=12000
AI_MAX_RESPONSE_BYTES=65536
# Hard cap for compiled creative context; prevents prompt inflation as features grow.
AI_CREATIVE_PROMPT_MAX_BYTES=28000
AI_WOW_REPAIR_THRESHOLD=0.70
AI_CONFIDENCE_REPAIR_THRESHOLD=0.62
AI_NOVELTY_REPAIR_THRESHOLD=0.50
# Optional cost model in USD per 1M tokens; used only for operational estimates.
AI_INPUT_COST_PER_MILLION_USD=
AI_OUTPUT_COST_PER_MILLION_USD=
GENERATION_STATUS_SECRET=

# ---------- Cloudflare Tunnel ----------
# Same token/UUID on Pi5 and VPS for Phase-1 shared-tunnel HA.
TUNNEL_TOKEN=

# ---------- Worker tuning ----------
AI_PLAN_CONCURRENCY=3
FINAL_RENDER_CONCURRENCY=1
CLEANUP_CONCURRENCY=1
PHOTO_QUARANTINE_TTL_MINUTES=120
GENERATION_JOB_TTL_MINUTES=5
# Transient AI brief/result rows are deleted after this many days.
GENERATION_RESULT_RETENTION_DAYS=7
# HMAC status capability lifetime; normal generation polling is only seconds long.
GENERATION_STATUS_TTL_MINUTES=15
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_MAX_AGE_SECONDS=45

# Server-side fixed-window abuse guards per anonymous session.
# Cloudflare edge rate limits should still be enabled before public launch.
GENERATION_RATE_LIMIT_PER_HOUR=12
PHOTO_UPLOAD_RATE_LIMIT_PER_HOUR=8
CHECKOUT_RATE_LIMIT_PER_HOUR=12


# ---------- Production renderer ----------
# Worker Docker image installs EB Garamond + Lato + Noto CJK from Debian.
# Production refuses silent system-font drift when these deterministic dirs are missing.
RENDER_REQUIRE_DETERMINISTIC_FONTS=true
# Override only if your runtime mounts equivalent licensed/open TTF/OTF/TTC fonts.
# Comma-separated directories. Leave blank for the Docker defaults.
RENDER_FONT_DIRS=

# ---------- Public launch gate ----------
# Owner-approved public-beta legal copy. This does not activate payment or approve paid launch.
LEGAL_CONTENT_APPROVED=true
LEGAL_NATIVE_COPY=APPROVED

# ---------- Observability ----------
SENTRY_DSN=
LOG_LEVEL=info

# ---------- Secure paid recovery ----------
# Durable purchase recovery and same-browser HttpOnly session are capped here.
# Files the customer downloads remain theirs; this is the cloud recovery window.
RECOVERY_TOKEN_TTL_DAYS=365
RECOVERY_SESSION_TTL_DAYS=365
# Short-lived claim placed in the payment-provider success/return URL.
# Separate HMAC key; minimum 32 characters in production.
CHECKOUT_RETURN_SECRET=
CHECKOUT_RETURN_CLAIM_TTL_MINUTES=60
# Allows brief retry after a successful return claim in case the redirect/cookie
# response is interrupted. The claim becomes unusable after this grace period.
CHECKOUT_RETURN_REPLAY_GRACE_MINUTES=10
# Private R2 URL minted only after recovery entitlement verification.
RECOVERY_DOWNLOAD_URL_TTL_SECONDS=90

# Step 12 managed template admin (HTTP Basic protected; use a long random password in live mode)
TEMPLATE_ADMIN_USERNAME=cardelume-admin
TEMPLATE_ADMIN_PASSWORD=
# HMAC capability for privacy-safe template analytics slots; minimum 32 chars in production.
TEMPLATE_EVENT_SECRET=
TEMPLATE_EVENT_RATE_LIMIT_PER_HOUR=120

# Template analytics: raw privacy-safe events roll up daily before retention cleanup.
TEMPLATE_EVENT_RETENTION_DAYS=90
# Content-free recent style memory for freshness/personalization.
STYLE_FINGERPRINT_RETENTION_DAYS=180
# Detailed model/token/latency ledger; no raw prompt or user copy.
AI_USAGE_RETENTION_DAYS=30

# Step 17F launch/legal/security gates. Production validation requires these.
LEGAL_ENTITY_NAME=TU PHUC SINH
LEGAL_CONTACT_EMAIL=tuphucsinh@gmail.com
LEGAL_ENTITY_ADDRESS=19b Tran Van Dang street, HCMC, Vietnam
LEGAL_EFFECTIVE_DATE=2026-09-03
ADMIN_REQUIRE_EDGE_ACCESS=false
CSP_ENFORCE=false
FUNNEL_EVENT_RETENTION_DAYS=180
REWRITE_RATE_LIMIT_PER_HOUR=30
ANALYTICS_EVENT_RATE_LIMIT_PER_HOUR=240
# >=32 random bytes; used only for HMAC pseudonymous funnel subject IDs. Rotate only with an explicit analytics continuity decision.
ANALYTICS_PSEUDONYM_KEY=
